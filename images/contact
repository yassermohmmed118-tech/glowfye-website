<script>
	document.addEventListener('DOMContentLoaded', () => {
  const customCursor = document.querySelector('.custom-cursor');
  if (!customCursor) {
    console.warn('Custom cursor element with class ".custom-cursor" not found.');
    return;
  }

  const animationOptions = {
    duration: 300,
    easing: 'ease-in-out',
    fill: 'forwards',
  };

  const expandKeyframes = [
    { width: '15px', height: '15px', opacity: 1 },
    { width: '48px', height: '48px', opacity: 0 }
  ];

  const shrinkKeyframes = [
    { width: '48px', height: '48px', opacity: 0 },
    { width: '15px', height: '15px', opacity: 1 }
  ];

  const expandDimensionsKeyframes = [
    { width: '15px', height: '15px'},
    { width: '80px', height: '80px'}
  ];

  function expandCursor({ dimensions = false } = {}) {
    if (dimensions) {
      customCursor.animate(expandDimensionsKeyframes, animationOptions);
      customCursor.style.margin = '-40px 0 0 -40px';
    } else {
      customCursor.animate(expandKeyframes, animationOptions);
    }
  }

  function shrinkCursor({ dimensions = false } = {}) {
    customCursor.animate(shrinkKeyframes, animationOptions);
    if (dimensions) {
      customCursor.style.margin = '-7.5px 0 0 -7.5px';
    }
  }

  // Event Delegation for general hover targets
  document.addEventListener('mouseover', (e) => {
    const target = e.target.closest('a:not(.feature_templates_card):not(.templates_card), button:not(.template-item):not(.templates_card), .w-dropdown:not(.templates_card), .horizontal-item:not(.templates_card), input, .file-upload, .form_input_block, textarea');
    if (target) expandCursor();
  });

  document.addEventListener('mouseout', (e) => {
    const target = e.target.closest('a:not(.feature_templates_card):not(.templates_card), button:not(.template-item):not(.templates_card), .w-dropdown:not(.templates_card), .horizontal-item:not(.templates_card), input, .file-upload, .form_input_block, textarea');
    if (target) shrinkCursor();
  });

  // Event Delegation for feature/template cards
  document.addEventListener('mouseover', (e) => {
    const card = e.target.closest('.feature_templates_card, .templates_card');
    if (!card) return;

    customCursor.classList.add('hovered');
    expandCursor({ dimensions: true });

    const arrowGradient = customCursor.querySelector('.arrow-gradient');
    if (arrowGradient) {
      arrowGradient.style.display = 'block';
      arrowGradient.animate([{ opacity: 0 }, { opacity: 1 }], {
        duration: 300,
        easing: 'ease-in-out',
        fill: 'forwards'
      });
    }
  });

  document.addEventListener('mouseout', (e) => {
    const card = e.target.closest('.feature_templates_card, .templates_card');
    if (!card) return;

    customCursor.classList.remove('hovered');
    shrinkCursor({ dimensions: true });

    const arrowGradient = customCursor.querySelector('.arrow-gradient');
    if (arrowGradient) {
      arrowGradient.animate([{ opacity: 1 }, { opacity: 0 }], {
        duration: 300,
        easing: 'ease-in-out',
        fill: 'forwards'
      });
      arrowGradient.style.display = 'none';
    }
  });

  // Shrink cursor on scroll unless hovered
  window.addEventListener('scroll', () => {
    if (!customCursor.classList.contains('hovered')) {
      customCursor.style.width = '15px';
      customCursor.style.height = '15px';
      customCursor.style.margin = '-7.5px 0 0 -7.5px';
    }
  });
});

