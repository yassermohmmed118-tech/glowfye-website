<script>
document.addEventListener('DOMContentLoaded', function() {
    /**
     * Creates a custom dropdown for each select element with the class '.is-select'.
     * @param {HTMLSelectElement} selectElement The original select element.
     */
    function setupCustomSelect(selectElement) {
        // Create a wrapper and move the original select element inside it
        const customSelectWrapper = document.createElement('div');
        customSelectWrapper.className = 'custom-select-wrapper';
        selectElement.parentNode.insertBefore(customSelectWrapper, selectElement);
        customSelectWrapper.appendChild(selectElement);

        // Create the custom select structure that will be visible
        const customSelect = document.createElement('div');
        customSelect.className = 'custom-select';

        // Hide the original select element
        selectElement.style.display = 'none';

        // Create the trigger element (the part you click to open the dropdown)
        const trigger = document.createElement('div');
        trigger.className = 'custom-select__trigger';
        const selectedDisplay = document.createElement('span');
        selectedDisplay.textContent = selectElement.options[selectElement.selectedIndex].text;
        selectedDisplay.className = 'custom-select__display'; // Add a base class for styling
        // If a value is pre-selected (and not empty), add a class to the display span.
        if (selectElement.value) {
            selectedDisplay.classList.add('is-selected');
        }

        const arrow = document.createElement('div');
        arrow.className = 'arrow';
        // Use the provided SVG for the arrow icon, with minor corrections for visibility and validity.
        arrow.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none"><g clip-path="url(#clip0_3008_4744)"><path d="M7.33348 3.33335V10.78L4.08014 7.52669C3.82014 7.26669 3.39348 7.26669 3.13348 7.52669C2.87348 7.78669 2.87348 8.20669 3.13348 8.46669L7.52681 12.86C7.78681 13.12 8.20681 13.12 8.46681 12.86L12.8601 8.46669C13.1201 8.20669 13.1201 7.78669 12.8601 7.52669C12.6001 7.26669 12.1801 7.26669 11.9201 7.52669L8.66681 10.78V3.33335C8.66681 2.96669 8.36681 2.66669 8.00014 2.66669C7.63348 2.66669 7.33348 2.96669 7.33348 3.33335Z" fill="#516056"/></g><defs><clipPath id="clip0_3008_4744"><rect width="16" height="16" fill="white"/></clipPath></defs></svg>`;
        trigger.appendChild(selectedDisplay);
        trigger.appendChild(arrow);

        // Create the options container
        const optionsContainer = document.createElement('div');
        optionsContainer.className = 'custom-options';

        // Populate custom options from the original select's <option> tags
        Array.from(selectElement.options).forEach(optionElement => {
            const customOption = document.createElement('span');
            customOption.className = 'custom-option';
            customOption.textContent = optionElement.text;
            customOption.dataset.value = optionElement.value;

            if (optionElement.selected) {
                customOption.classList.add('selected');
            }

            customOption.addEventListener('click', function() {
                // When a custom option is clicked, update the state
                const previouslySelected = optionsContainer.querySelector('.custom-option.selected');
                if (previouslySelected) {
                    previouslySelected.classList.remove('selected');
                }
                this.classList.add('selected');

                // Update the text in the trigger
                selectedDisplay.textContent = this.textContent;
                
                // Update the value of the hidden native select element.
                // Setting the .value property is the standard way to programmatically
                // change the selected option and is what matters for form submission.
                selectElement.value = this.dataset.value;

                // Toggle a class on the trigger's span based on whether a value was selected.
                // This is useful for styling the placeholder differently from a selected option.
                if (this.dataset.value) {
                    selectedDisplay.classList.add('is-selected');
                } else {
                    selectedDisplay.classList.remove('is-selected');
                }

                // To ensure the `selected` attribute is visible in the browser's
                // developer tools, we'll manually update it.
                // First, remove the attribute from any previously selected option.
                const previouslySelectedOption = selectElement.querySelector('option[selected]');
                if (previouslySelectedOption) {
                    previouslySelectedOption.removeAttribute('selected');
                }
                // Then, add the attribute to the newly selected option.
                const newSelectedOption = selectElement.querySelector(`option[value="${this.dataset.value}"]`);
                if (newSelectedOption) {
                    newSelectedOption.setAttribute('selected', 'selected');
                }
                // Fire the 'change' event on the native select, so other scripts can react.
                selectElement.dispatchEvent(new Event('change'));

                // Close the dropdown
                customSelect.classList.remove('open');
            });

            optionsContainer.appendChild(customOption);
        });

        // Assemble the custom select and add it to the wrapper
        customSelect.appendChild(trigger);
        customSelect.appendChild(optionsContainer);
        customSelectWrapper.appendChild(customSelect);

        // Add event listener to the trigger to open/close the dropdown
        trigger.addEventListener('click', (e) => {
            e.stopPropagation(); // Prevent the global click listener from closing it immediately
            // Close any other open select dropdowns
            closeAllSelects(customSelect);
            // Toggle the 'open' class for the current dropdown
            customSelect.classList.toggle('open');
        });
    }

    /**
     * Closes all custom select dropdowns except for the one passed as an argument.
     * @param {HTMLElement} currentSelect The select element to exclude from closing.
     */
    function closeAllSelects(currentSelect = null) {
        document.querySelectorAll('.custom-select.open').forEach(openSelect => {
            if (openSelect !== currentSelect) {
                openSelect.classList.remove('open');
            }
        });
    }

    // Find and set up all designated select elements on the page
    document.querySelectorAll('.form_input.is-select').forEach(setupCustomSelect);

    // Add a global click listener to close dropdowns when clicking outside of them
    document.addEventListener('click', () => {
        closeAllSelects();
    });
});
</script>

<script>
// on dom load find all .horizontal-item inside them will be .testimonials_media inside that will video .testimonials_video-bg and .video-play
// on clicking each .testimonials_media find video-play inside it and play the video but hid the testimonials_video-bg
document.addEventListener("DOMContentLoaded", function() {
    const horizontalItems = document.querySelectorAll('.horizontal-item');
    let activeMediaElement = null; // Tracks the container of the currently playing video

    // Helper to reset a video to its initial state
    const resetVideoState = (mediaElement) => {
        if (!mediaElement) return;
        const video = mediaElement.querySelector('.video-play');
        const bg = mediaElement.querySelector('.testimonials_video-bg');
        const playIcon = mediaElement.querySelector('.video_play');
        const pauseIcon = mediaElement.querySelector('.video_pause');

        if (video) {
            video.pause();
            video.currentTime = 0;
        }
        if (bg) {
            bg.style.display = ''; // Revert to stylesheet default
        }
        // Set icon state to 'paused'
        if (playIcon) playIcon.style.display = 'flex';
        if (pauseIcon) pauseIcon.style.display = 'none';
    };

    horizontalItems.forEach(item => {
        const testimonialsMedia = item.querySelector('.testimonials_media');
        if (!testimonialsMedia) return; // Skip if no media container

        const videoBg = testimonialsMedia.querySelector('.testimonials_video-bg');
        const videoPlay = testimonialsMedia.querySelector('.video-play');
        if (!videoPlay) return; // Skip if no video element

        const playVideo = () => {
            // If another video is playing, reset it first
            if (activeMediaElement && activeMediaElement !== testimonialsMedia) {
                resetVideoState(activeMediaElement);
            }

            // Find icons for the current video
            const playIcon = testimonialsMedia.querySelector('.video_play');
            const pauseIcon = testimonialsMedia.querySelector('.video_pause');

            // Play the current video
            if (videoBg) {
                videoBg.style.display = 'none';
            }
            // Set icon state to 'playing'
            if (playIcon) playIcon.style.display = 'none';
            if (pauseIcon) pauseIcon.style.display = 'flex';

            videoPlay.play();
            activeMediaElement = testimonialsMedia; // Set this as the active one
        };

        const resetThisVideo = () => {
            resetVideoState(testimonialsMedia);
            // If this was the active video, clear the active state
            if (activeMediaElement === testimonialsMedia) {
                activeMediaElement = null;
            }
        };

        testimonialsMedia.addEventListener('click', () => {
            if (videoPlay.paused) {
                playVideo();
            } else {
                resetThisVideo();
            }
        });

        // Also reset when the video finishes playing on its own
        videoPlay.addEventListener('ended', resetThisVideo);
    });
});
</script>
