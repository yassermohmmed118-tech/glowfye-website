<script>
document.addEventListener('DOMContentLoaded', () => {
  const projectItems = document.querySelectorAll('.projects_item');

  // Store initial display states for all project items' borders
  const initialStates = new Map();
  projectItems.forEach((item, index) => {
    const border = item.querySelector('.project_custom-border');
    const title = item.querySelector('.project_item_title-text')?.textContent || `Item ${index + 1}`;
    initialStates.set(item, {
      border: border ? getComputedStyle(border).display : null,
      title: title
    });
  });

  projectItems.forEach((item, index) => {
    const title = initialStates.get(item).title;

    item.addEventListener('mouseenter', () => {
      // Hide border of current item
      const border = item.querySelector('.project_custom-border');
      if (border) {
        border.style.display = 'none';
      }

      // Find and hide border of previous sibling
      const prevSibling = item.previousElementSibling;
      if (prevSibling && prevSibling.classList.contains('projects_item')) {
        const prevBorder = prevSibling.querySelector('.project_custom-border');
        if (prevBorder) {
          prevBorder.style.display = 'none';
        }
      }
    });

    item.addEventListener('mouseleave', () => {
      // Restore border of current item
      const border = item.querySelector('.project_custom-border');
      if (border) {
        const initialDisplay = initialStates.get(item).border;
        border.style.display = initialDisplay || '';
      }

      // Restore border of previous sibling
      const prevSibling = item.previousElementSibling;
      if (prevSibling && prevSibling.classList.contains('projects_item')) {
        const prevBorder = prevSibling.querySelector('.project_custom-border');
        if (prevBorder) {
          const prevInitialDisplay = initialStates.get(prevSibling).border;
          prevBorder.style.display = prevInitialDisplay || '';
        }
      }
    });
  });
});
</script>

