        if (animElement.length === 0) {
          // If the ".fill" element doesn't exist, create it
          button.append('<div class="fill"></div>');
          animElement = button.find(".fill");
        }

        button
          .on("mouseenter", function (e) {
            var parentOffset = button.offset(),
              relX = e.pageX - parentOffset.left,
              relY = e.pageY - parentOffset.top;
            gsap.set(animElement, { css: { top: relY, left: relX } });
          })
          .on("mouseout", function (e) {
            var parentOffset = button.offset(),
              relX = e.pageX - parentOffset.left,
              relY = e.pageY - parentOffset.top;
            gsap.set(button.find(".fill"), { css: { top: relY, left: relX } });
          });
      });
    });  
