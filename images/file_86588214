<script>

    const nav = document.querySelector('.navigation');

    // Set initial state
    let isSticky = false;
    let isHidden = false;
    let isAtTop = false;
    let shouldAddDelay = false; // New flag
    let lastScrollPos = window.scrollY;

    // Function to handle scroll events
    function handleScroll() {
        const scrollPos = window.scrollY;

        // Check if scrolling down
        if (scrollPos > lastScrollPos && !isHidden) {
            isHidden = true;
            isSticky = false;
            isAtTop = false;
            shouldAddDelay = true; // Reset the flag
            animateNav();
        }

        // Check if scrolling up
        if (scrollPos < lastScrollPos && isHidden && scrollPos >= 500) {
            isHidden = false;
            isSticky = true;
            isAtTop = false;
            shouldAddDelay = true; // Reset the flag
            animateNav();
        }

        // Check if at the top
        if (scrollPos < 500) {
            isSticky = false;
            isHidden = false;
            isAtTop = true;
            shouldAddDelay = false; // Set the flag
            animateNav();
        }

        lastScrollPos = scrollPos;
    }

    // Function to animate the navigation
    function animateNav() {
        const translateY = isHidden ? '-100%' : '0%';
        const transformValue = `translateY(${translateY})`;

        if (isAtTop) {
            nav.style.position = 'relative';
            nav.style.transition = '';
            nav.style.backgroundColor = 'transparent';
            nav.classList.remove('isSticky'); // Remove the class if not sticky
        } else if (isHidden) {
            nav.style.transition = 'transform 0.5s ease-out';
            nav.style.backgroundColor = '#172b1d';
            nav.classList.remove('isSticky'); // Remove the class if not sticky

            if (shouldAddDelay) {
                setTimeout(() => {
                    nav.style.position = 'relative';
                    nav.style.transition = '';
                    nav.style.top = '0';
                }, 500);
            } else {
                nav.style.position = 'relative';
                nav.style.transition = '';
            }
        } else if (isSticky) {
            nav.style.position = 'sticky';
            nav.style.top = '0';
            nav.style.transition = 'transform 0.5s ease-out';
            nav.style.backgroundColor = '#172b1d';
            nav.classList.add('isSticky'); // Add the class if sticky
        }

        nav.style.transform = transformValue;
    }

    // Add scroll event listener
    window.addEventListener('scroll', handleScroll);

    // Initial call to set styles based on the initial state
    handleScroll();

    window.addEventListener('load', handleScrollOnLoad);

    function handleScrollOnLoad() {
        if (window.scrollY > 500) {
            nav.style.position = 'sticky';
            nav.style.top = '0';
            nav.style.transition = 'transform 0.5s ease-out';
            nav.style.backgroundColor = '#172b1d';
            nav.classList.add('isSticky');
        }
    }

</script>
  
  
