<script>
const daysEl = document.getElementById("days");
const hoursEl = document.getElementById("hours");
const minutesEl = document.getElementById("minutes");
const secondsEl = document.getElementById("seconds");

const targetDate = new Date("Sep 27, 2025 23:59:59+06:00").getTime();

function pad(num) {
  return String(num).padStart(2, "0");
}

function updateCountdown() {
  const now = Date.now();
  const distance = targetDate - now;

  if (distance <= 0) {
    daysEl.textContent = "0";
    hoursEl.textContent = "00";
    minutesEl.textContent = "00";
    secondsEl.textContent = "00";
    clearInterval(timer);
    return;
  }

  const totalSeconds = Math.floor(distance / 1000);
  const days = Math.floor(totalSeconds / (3600 * 24));
  const hours = Math.floor((totalSeconds % (3600 * 24)) / 3600);
  const minutes = Math.floor((totalSeconds % 3600) / 60);
  const seconds = totalSeconds % 60;

  daysEl.textContent = days;
  hoursEl.textContent = pad(hours);
  minutesEl.textContent = pad(minutes);
  secondsEl.textContent = pad(seconds);
}

updateCountdown();
const timer = setInterval(updateCountdown, 1000);
</script>
<!-- GSAP Horizontal Scroll and Video Playback Script -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        // GSAP and ScrollTrigger setup
        gsap.registerPlugin(ScrollTrigger);

        const horizontalSection = document.querySelector(".horizontal-section");
        let moveDistance;

        function calculateScroll() {
            const listElement = document.querySelector(".horizontal-section .list");
            if (!listElement) return; // safeguard if not found

            // Compute gap
            const computedGap = parseFloat(getComputedStyle(listElement).gap || "0");

            // Get all horizontal items
            const horizontalItems = listElement.querySelectorAll(".horizontal-item");
            const totalItems = horizontalItems.length;

            // Total width of all items + gaps
            let totalWidth = 0;
            horizontalItems.forEach((item, index) => {
                totalWidth += item.offsetWidth;
                if (index < totalItems - 1) totalWidth += computedGap;
            });

            // Container (viewport) width
            const containerWidth = listElement.parentElement.offsetWidth;

            // Scroll distance needed to align last item flush with viewport
            moveDistance = totalWidth - containerWidth;

            // If content fits within viewport, no movement needed
            if (moveDistance <= 0) {
                moveDistance = 0;
                horizontalSection.style.height = "100vh";
            } else {
                horizontalSection.style.height = "200vh";
            }

            // Set a min-height based on average item width
            const averageItemWidth = totalWidth / totalItems;
            const minHeight = 1.2 * averageItemWidth * totalItems;
            horizontalSection.style.minHeight = minHeight + "px";

            // Refresh ScrollTrigger on layout changes
            ScrollTrigger.refresh();
        }

        // Run only after everything is loaded (images, fonts, etc.)
        window.addEventListener("load", function () {
            calculateScroll();
            window.addEventListener("resize", calculateScroll);
        });

        // Create GSAP ScrollTrigger animation
        const tl = gsap.timeline({
            scrollTrigger: {
                trigger: ".horizontal-section",
                start: "top+=10vh top", // start when section’s top is 10vh below viewport top
                end: "bottom top",
                invalidateOnRefresh: true,
                scrub: 1
            }
        });

        // Animate the list horizontally by the computed moveDistance
        tl.to(".horizontal-section .list", {
            x: () => -moveDistance,
            duration: 1
        });

        // Video playback control
        const videoItems = document.querySelectorAll('.horizontal-item');
        let activeMediaElement = null;

        // Helper to reset a video to its initial state
        const resetVideoState = (mediaElement) => {
            if (!mediaElement) return;
            const video = mediaElement.querySelector('.video-play');
            const bg = mediaElement.querySelector('.testimonials_video-bg');
            const playIcon = mediaElement.querySelector('.video_play');
            const pauseIcon = mediaElement.querySelector('.video_pause');

            if (video) {
                video.pause();
                video.currentTime = 0;
            }
            if (bg) bg.style.display = '';
            if (playIcon) playIcon.style.display = 'flex';
            if (pauseIcon) pauseIcon.style.display = 'none';
        };

        videoItems.forEach(item => {
            const testimonialsMedia = item.querySelector('.testimonials_media');
            if (!testimonialsMedia) return;

            const videoPlay = testimonialsMedia.querySelector('.video-play');
            if (!videoPlay) return;

            const playVideo = () => {
                if (activeMediaElement && activeMediaElement !== testimonialsMedia) {
                    resetVideoState(activeMediaElement);
                }

                const playIcon = testimonialsMedia.querySelector('.video_play');
                const pauseIcon = testimonialsMedia.querySelector('.video_pause');
                const videoBg = testimonialsMedia.querySelector('.testimonials_video-bg');

                if (videoBg) videoBg.style.display = 'none';
                if (playIcon) playIcon.style.display = 'none';
                if (pauseIcon) pauseIcon.style.display = 'flex';

                videoPlay.play();
                activeMediaElement = testimonialsMedia;
            };

            const resetThisVideo = () => {
                resetVideoState(testimonialsMedia);
                if (activeMediaElement === testimonialsMedia) {
                    activeMediaElement = null;
                }
            };

            testimonialsMedia.addEventListener('click', () => {
                if (videoPlay.paused) {
                    playVideo();
                } else {
                    resetThisVideo();
                }
            });

            videoPlay.addEventListener('ended', resetThisVideo);
        });
    });
</script>





<!-- GSAP Horizontal Scroll and Video Playback Script -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        // GSAP and ScrollTrigger setup
        gsap.registerPlugin(ScrollTrigger);

        const horizontalSection = document.querySelector(".horizontal-section");
        let moveDistance;

        function calculateScroll() {
            const listElement = document.querySelector(".horizontal-section .list");
            if (!listElement) return; // safeguard if not found

            // Compute gap
            const computedGap = parseFloat(getComputedStyle(listElement).gap || "0");

            // Get all horizontal items
            const horizontalItems = listElement.querySelectorAll(".horizontal-item");
            const totalItems = horizontalItems.length;

            // Total width of all items + gaps
            let totalWidth = 0;
            horizontalItems.forEach((item, index) => {
                totalWidth += item.offsetWidth;
                if (index < totalItems - 1) totalWidth += computedGap;
            });

            // Container (viewport) width
            const containerWidth = listElement.parentElement.offsetWidth;

            // Scroll distance needed to align last item flush with viewport
            moveDistance = totalWidth - containerWidth;

            // If content fits within viewport, no movement needed
            if (moveDistance <= 0) {
                moveDistance = 0;
                horizontalSection.style.height = "100vh";
            } else {
                horizontalSection.style.height = "200vh";
            }

            // Set a min-height based on average item width
            const averageItemWidth = totalWidth / totalItems;
            const minHeight = 1.2 * averageItemWidth * totalItems;
            horizontalSection.style.minHeight = minHeight + "px";

            // Refresh ScrollTrigger on layout changes
            ScrollTrigger.refresh();
        }

        // Run only after everything is loaded (images, fonts, etc.)
        window.addEventListener("load", function () {
            calculateScroll();
            window.addEventListener("resize", calculateScroll);
        });

        // Create GSAP ScrollTrigger animation
        const tl = gsap.timeline({
            scrollTrigger: {
                trigger: ".horizontal-section",
                start: "top+=10vh top", // start when section’s top is 10vh below viewport top
                end: "bottom top",
                invalidateOnRefresh: true,
                scrub: 1
            }
        });

        // Animate the list horizontally by the computed moveDistance
        tl.to(".horizontal-section .list", {
            x: () => -moveDistance,
            duration: 1
        });

        // Video playback control
       document.addEventListener("DOMContentLoaded", function() {
    const horizontalItems = document.querySelectorAll('.horizontal-item');
    let activeMediaElement = null; // Tracks the container of the currently playing video

    // Helper to reset a video to its initial state
    const resetVideoState = (mediaElement) => {
        if (!mediaElement) return;
        const video = mediaElement.querySelector('.video-play');
        const bg = mediaElement.querySelector('.testimonials_video-bg');
        const playIcon = mediaElement.querySelector('.video_play');
        const pauseIcon = mediaElement.querySelector('.video_pause');

        if (video) {
            video.pause();
            video.currentTime = 0;
        }
        if (bg) {
            bg.style.display = ''; // Revert to stylesheet default
        }
        // Set icon state to 'paused'
        if (playIcon) playIcon.style.display = 'flex';
        if (pauseIcon) pauseIcon.style.display = 'none';
    };

    horizontalItems.forEach(item => {
        const testimonialsMedia = item.querySelector('.testimonials_media');
        if (!testimonialsMedia) return; // Skip if no media container

        const videoBg = testimonialsMedia.querySelector('.testimonials_video-bg');
        const videoPlay = testimonialsMedia.querySelector('.video-play');
        if (!videoPlay) return; // Skip if no video element

        const playVideo = () => {
            // If another video is playing, reset it first
            if (activeMediaElement && activeMediaElement !== testimonialsMedia) {
                resetVideoState(activeMediaElement);
            }

            // Find icons for the current video
            const playIcon = testimonialsMedia.querySelector('.video_play');
            const pauseIcon = testimonialsMedia.querySelector('.video_pause');

            // Play the current video
            if (videoBg) {
                videoBg.style.display = 'none';
            }
            // Set icon state to 'playing'
            if (playIcon) playIcon.style.display = 'none';
            if (pauseIcon) pauseIcon.style.display = 'flex';

            videoPlay.play();
            activeMediaElement = testimonialsMedia; // Set this as the active one
        };

        const resetThisVideo = () => {
            resetVideoState(testimonialsMedia);
            // If this was the active video, clear the active state
            if (activeMediaElement === testimonialsMedia) {
                activeMediaElement = null;
            }
        };

        testimonialsMedia.addEventListener('click', () => {
            if (videoPlay.paused) {
                playVideo();
            } else {
                resetThisVideo();
            }
        });

        // Also reset when the video finishes playing on its own
        videoPlay.addEventListener('ended', resetThisVideo);
    });
});
</script>

</body></html>